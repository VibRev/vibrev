{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"]
    },
    "vibrev-ida": {
      "command": "<SANDBOX>/home/.vibrev/engines/ida-headless-mcp",
      "args": ["serve", "--mode", "stdio"]
    },
    "vibrev-jadx": {
      "command": "<SANDBOX>/home/.vibrev/engines/rjadx",
      "args": ["mcp", "--stdio"]
    }
  }
}
